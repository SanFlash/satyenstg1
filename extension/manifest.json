{
  "manifest_version": 3,
  "name": "SatyTracker78 — Record & Repeat",
  "version": "1.2.1",
  "description": "Record and replay authorized browser workflows. Created by Satyendra Kumar Namdeo.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "SatyTracker78",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon48.png",
      "32": "icon48.png",
      "48": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon48.png",
    "32": "icon48.png",
    "48": "icon48.png",
    "128": "icon48.png"
  }
}
