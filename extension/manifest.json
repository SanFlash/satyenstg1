{
  "manifest_version": 3,
  "name": "MouseFlow AI — Record & Repeat",
  "version": "1.1.0",
  "description": "Record authorized browser interactions and repeat the flow until you stop it.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "MouseFlow AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
