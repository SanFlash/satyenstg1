{
  "manifest_version": 3,
  "name": "SatyTracker78 — Record & Repeat",
  "version": "1.2.1",
  "description": "Record and replay authorized browser workflows. Created by Satyendra Kumar Namdeo.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "SatyTracker78",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
